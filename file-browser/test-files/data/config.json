{
  "appName": "文件浏览器",
  "version": "1.0.0",
  "settings": {
    "theme": "light",
    "language": "zh-CN",
    "pageSize": 20,
    "showHiddenFiles": false
  },
  "supportedTypes": {
    "text": [". txt", ".md", ".js", ".vue", ".css", ".html"],
    "image": [". jpg", ".jpeg", ".png", ".gif", ".svg", ".webp"],
    "video": [".mp4", ".webm", ".ogg"],
    "audio": [".mp3", ".wav", ".ogg"]
  },
  "server": {
    "host": "localhost",
    "port": 3000,
    "cors": true
  }
}